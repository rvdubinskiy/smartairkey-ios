# Xcode / build
build/
DerivedData/
*.xcodeproj
*.xcworkspace
!default.xcworkspace
xcuserdata/
*.xcuserstate
*.moved-aside
*.hmap
*.ipa
*.dSYM.zip
*.dSYM

# CocoaPods (installed locally; not vendored)
Pods/
Podfile.lock

# SwiftPM
.swiftpm/
.build/

# The SmartAirKey binary SDK (Vendor/SDK) IS committed so the project builds
# out of the box. Ignore anything else that lands under Vendor/.
Vendor/*
!Vendor/SDK/

# Signing / fastlane (never commit certificates or build reports)
*.p12
*.p8
*.mobileprovision
*.cer
fastlane/report.xml
fastlane/Preview.html
fastlane/test_output/
fastlane/README.md

# macOS
.DS_Store
