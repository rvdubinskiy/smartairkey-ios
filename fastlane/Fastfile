default_platform(:ios)

platform :ios do
  desc "Build the app and upload it to TestFlight"
  lane :beta do
    # Creates an isolated temporary keychain on CI (and exports
    # MATCH_KEYCHAIN_NAME / MATCH_KEYCHAIN_PASSWORD used below).
    setup_ci

    # Auth for signing (provisioning) and for the TestFlight upload.
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: ENV.fetch("ASC_KEY_CONTENT"),
      is_key_content_base64: true
    )

    # Import the Apple Distribution certificate (private key) from the .p12
    # decoded by the workflow. The provisioning profile is created/fetched
    # automatically at build time via the API key (-allowProvisioningUpdates).
    import_certificate(
      certificate_path: ENV.fetch("DIST_CERT_PATH", "dist_cert.p12"),
      certificate_password: ENV.fetch("DIST_CERT_PASSWORD"),
      keychain_name: ENV.fetch("MATCH_KEYCHAIN_NAME", "fastlane_tmp_keychain"),
      keychain_password: ENV.fetch("MATCH_KEYCHAIN_PASSWORD", "")
    )

    # Unique, increasing build number per version (CI run number).
    build_number = ENV.fetch("BUILD_NUMBER", Time.now.strftime("%y%m%d%H%M"))

    build_app(
      workspace: "SmartAirKey.xcworkspace",
      scheme: "SmartAirKey",
      configuration: "Release",
      export_method: "app-store",
      xcargs: "DEVELOPMENT_TEAM=#{ENV.fetch('APPLE_TEAM_ID')} CURRENT_PROJECT_VERSION=#{build_number} -allowProvisioningUpdates",
      export_options: {
        method: "app-store",
        teamID: ENV.fetch("APPLE_TEAM_ID"),
        signingStyle: "automatic"
      }
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end
end
