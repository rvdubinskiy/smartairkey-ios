default_platform(:ios)

platform :ios do
  desc "Build the app and upload it to TestFlight"
  lane :beta do
    # Creates an isolated temporary keychain on CI (and exports
    # MATCH_KEYCHAIN_NAME / MATCH_KEYCHAIN_PASSWORD used below).
    setup_ci

    # Auth for signing (provisioning) and for the TestFlight upload.
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: ENV.fetch("ASC_KEY_CONTENT"),
      is_key_content_base64: true
    )

    # Import the Apple Distribution certificate (private key) from the .p12
    # decoded by the workflow into the temporary CI keychain.
    import_certificate(
      certificate_path: ENV.fetch("DIST_CERT_PATH", "dist_cert.p12"),
      certificate_password: ENV.fetch("DIST_CERT_PASSWORD"),
      keychain_name: ENV.fetch("MATCH_KEYCHAIN_NAME", "fastlane_tmp_keychain"),
      keychain_password: ENV.fetch("MATCH_KEYCHAIN_PASSWORD", "")
    )

    team_id = ENV.fetch("APPLE_TEAM_ID")
    app_id = "com.smartairkey.seamless"

    # Fetch/create the App Store provisioning profile via the API key and install
    # it, so we can sign manually. (Automatic signing on CI fails with
    # "No Accounts" because xcodebuild has no signed-in Apple ID.)
    profile_name = get_provisioning_profile(
      api_key: api_key,
      app_identifier: app_id,
      force: true
    )

    # Bake the backend config into Info.plist so the installed TestFlight build
    # uses it (installed apps don't see the scheme's environment variables).
    info_plist = "SmartAirKey/Resources/Info.plist"
    if (base_url = ENV["SAK_BASE_URL"]) && !base_url.empty?
      set_info_plist_value(path: info_plist, key: "SAKBaseURL", value: base_url)
    end
    if (company_token = ENV["SAK_COMPANY_TOKEN"]) && !company_token.empty?
      set_info_plist_value(path: info_plist, key: "SAKCompanyToken", value: company_token)
    end

    # Unique, increasing build number per version (CI run number).
    build_number = ENV.fetch("BUILD_NUMBER", Time.now.strftime("%y%m%d%H%M"))

    build_app(
      workspace: "SmartAirKey.xcworkspace",
      scheme: "SmartAirKey",
      configuration: "Release",
      export_method: "app-store",
      xcargs: [
        "DEVELOPMENT_TEAM=#{team_id}",
        "CURRENT_PROJECT_VERSION=#{build_number}",
        "CODE_SIGN_STYLE=Manual",
        'CODE_SIGN_IDENTITY="Apple Distribution"',
        "PROVISIONING_PROFILE_SPECIFIER=\"#{profile_name}\""
      ].join(" "),
      export_options: {
        method: "app-store",
        teamID: team_id,
        signingStyle: "manual",
        provisioningProfiles: { app_id => profile_name }
      }
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end
end
